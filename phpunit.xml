<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
    bootstrap="vendor/autoload.php"
    colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <groups>
        <exclude>
            <!-- Tests du comportement ATTENDU de code aujourd'hui défectueux : voir
                 tests/Feature/Flows/EvenementCsvImportAttenduTest.php. Lancer à part avec l'option
                 « group » de phpunit : phpunit group bug-connu (deux tirets devant group) -->
            <group>bug-connu</group>
        </exclude>
    </groups>

    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing" />
        <env name="APP_MAINTENANCE_DRIVER" value="file" />
        <env name="BCRYPT_ROUNDS" value="4" />
        <env name="CACHE_STORE" value="array" />
        <env name="APP_KEY" value="base64:3rPmetArfkPOd0XO0aBzxd8odPNpJ3dxWiryQmTGzJA=" />
        <!--
            Base de données : MySQL 8 obligatoire (pas SQLite) — le code de
            production utilise FIELD() (RoleService, PersonnesController,
            EchangeController) et deux connexions distinctes (défaut = plan_*,
            'commun' = ref_personnes/ref_roles/audit_logs). Voir tests/README.md.

            Les NOMS de bases sont forcés (force="true") : ni un .env de dev
            ni une variable d'environnement ne peuvent les remplacer, ce qui
            empêche un `migrate:fresh` de tests de toucher amana_commun.
            Hôte / port / identifiants restent surchargeables (DB_HOST,
            DB_PORT, DB_USERNAME, DB_PASSWORD) — la CI les fournit.
        -->
        <env name="DB_CONNECTION" value="mysql" force="true" />
        <env name="DB_DATABASE" value="amana_planning_test" force="true" />
        <env name="DB_COMMUN_DATABASE" value="amana_commun_test" force="true" />
        <env name="LOG_CHANNEL" value="null" />
        <env name="MAIL_MAILER" value="array" />
        <env name="PULSE_ENABLED" value="false" />
        <env name="QUEUE_CONNECTION" value="sync" />
        <env name="SESSION_DRIVER" value="array" />
        <env name="TELESCOPE_ENABLED" value="false" />
    </php>
</phpunit>